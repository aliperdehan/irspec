\cs_new_protected:Npn \Lab@ovcheckpalette #1
  {
    \int_compare:nT { #1 > \clist_count:N \l__nulab_plot_ovcols_clist }
      { \msg_warning:nn { nulabreport } { overlay-palette-short } }
