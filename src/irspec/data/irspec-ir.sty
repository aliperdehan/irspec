% Internal: the tikzpicture/axis body of a single plot, shared by every
% kind and by both render paths (float and [none]). #1 kind, #2 the call's
% own pgfplots keys, #3 csv, #4 peak list. Up to v1.18.1 this was
% \Lab@irspectrumplot with the ir keys inline; the key order is unchanged
% (size, kind defaults, line width, then the call's own keys, last wins).
% line join=round (v1.21.1), here and in \Lab@stack's \labpanel: TikZ's
% default miter join draws a sharp trough tip as a spike past the data
% point, up to the miter limit (10 x half the line width). Measured on a
% 600 dpi render of a digitized SDBS spectrum (LR6): red ink up to 17 px
% (~1 %T) below the true minimum at sharp tips with miter; max 3 px with
% round, every CSV point on the line. Troughs read too deep otherwise.
\newcommand{\Lab@plotbody}[4]{%
  \Lab@pickstd@single
  \Lab@insets@build{#1}%
  \begin{tikzpicture}
    \begin{axis}[
      width=14.5cm, height=9.5cm,
      nulab kind #1,
      every axis plot/.append style={line width=0.5pt},
      #2,
    ]
    \addplot[color=\Lab@tc, line join=round] table[nulab kind #1 table,col sep=comma] {#3};
    \Lab@inintegrals
    \csname Lab@kind@#1@peaks\endcsname{#4}
    \Lab@inmarks
    \end{axis}
    \Lab@inaxes
  \end{tikzpicture}%
}
% Internal: one inset axis (v1.28.2). #1 kind, #2 its number (the corner
% coordinates Lab@in<n>sw/ne set in the main axis), #3 csv, #4 its own
% pgfplots keys, #5 peaks. scale only axis: the plot rectangle, not the tick
% labels under it, fills the box; south west is that rectangle's corner.
\newcommand{\Lab@insetaxis}[5]{%
  \pgfpointdiff{\pgfpointanchor{Lab@in#2sw}{center}}{\pgfpointanchor{Lab@in#2ne}{center}}%
  \pgfgetlastxy{\Lab@inw}{\Lab@inh}%
  \begin{axis}[
    at={(Lab@in#2sw)}, anchor=south west, scale only axis,
    width=\Lab@inw, height=\Lab@inh,
    nulab kind #1,
    every axis plot/.append style={line width=0.5pt},
    xlabel={}, enlarge x limits=false, enlarge y limits=false,
    tick label style={font=\scriptsize},
    #4,
  ]
  \addplot[color=\Lab@tc, line join=round] table[nulab kind #1 table,col sep=comma] {#3};
  \csname Lab@kind@#1@peaks\endcsname{#5}
  \end{axis}%
}
% Internal: [none] -> non-floating, anything else -> a float with that
% placement. The line breaks (spaces) around #2 reproduce exactly what
% \irspectrum's two inline copies of this had, so nothing moves.
\newcommand{\Lab@placeplot}[3]{%
  \ifstrequal{#1}{none}{%
    \begin{center}
    #2
    \captionof{figure}{#3}
    \end{center}
  }{%
    \begin{figure}[#1]
    \centering
    #2
    \Lab@figcaption{#3}
    \end{figure}%
  }%
}
% \labplot[kind=..., pgfplots keys][placement]{csv}{peaks}{caption}
%   The generic single plot. Placement as \irspectrum's (default H, or
%   none). Give the y label as ylabel={...} in the options when the kind's
%   default isn't right.
\newcommand{\Lab@labplot}[5]{%
  \Lab@plotsplit{#1}{\Lab@labplot@i{#2}{#3}{#4}{#5}}}
\newcommand{\Lab@labplot@i}[6]{%
  \Lab@placeplot{#1}{\Lab@plotbody{#5}{#6}{#2}{#3}}{#4}}
\NewDocumentCommand{\labplot}{O{} O{H} m m m}{\Lab@labplot{#1}{#2}{#3}{#4}{#5}}

% \irspectrum[pgfplots options][placement]{csv}{y-axis label}{peaks}{caption}
%   peaks = comma list of x/label_y pairs: 3320.8/70.9,3160.8/61.6,...
%   (pass ymin=<n> in the first optional argument once real peaks are
%   labelled — see the headroom note above)
%
%   Second optional argument (added 2026-09-18, v1.14.6): the LaTeX float
%   placement spec, default "H" -- every call before this version, in every
%   report, passes only the first bracket, so xparse's own default (its
%   `O{H}` below) reproduces the old hardcoded `[H]` exactly; nothing
%   existing changes behaviour. [H] remains the default because it is
%   still the right choice for the common case: a single \irspectrum
%   (9.5cm) surrounded by its own subsection's discussion essentially
%   always fits where it's called, and \irspectrum is sometimes used
%   inside `landscape`, where only [H] can be trusted (a real float cannot
%   move sensibly across that macro's page-dimension swap, sec. above).
%
%   A real LaTeX placement letter (t/b/p, in any combination) makes this a
%   genuine float -- tried first for LR3's appendix, WRONG for that case
%   and reverted: a float can reorder relative to the surrounding text, so
%   several \irspectrum calls each sitting right after their own bullet
%   point came out with the bullets and figures in different relative
%   order than the source (four bullets in a row, their figures reshuffled
%   onto a different page) -- exactly the "analysis -> spectrum, analysis
%   -> spectrum" pairing a report using this is likely to want defeated.
%   Real floats remain available for cases that DO want the float
%   algorithm's reordering (nothing in this codebase uses one yet).
%
%   `[none]` (the value, not a placement letter) instead renders NON-
%   floating -- \begin{center}...\captionof{figure}{...}...\end{center},
%   the same pattern sec. 7c above already validates and fixes the topsep/
%   partopsep/parsep spacing for. A non-floating block can never reorder
%   relative to source position (so strict interleaving holds, like [H]),
%   but unlike [H] it is never inserted through the float-placement
%   system at all -- when it doesn't fit the remaining page, normal TeX
%   page-breaking just starts a fresh page for it, the same as any other
%   oversized paragraph-level box, WITHOUT the "doesn't fit here, wastes
%   the remaining space instead of moving on" failure [H] (a genuine,
%   if pinned, float) has. This is what LR3's appendix uses. Trade-off:
%   loses [H]'s one advantage over a non-float, safety inside `landscape`
%   (untested here) -- keep using [H] there.
%
%   Since v1.19.0 a wrapper: \labplot with kind=ir and the y-axis label
%   argument turned into ylabel={...} ahead of the call's own keys.
\NewDocumentCommand{\irspectrum}{O{} O{H} m m m m}{%
  \Lab@labplot{kind=ir,ylabel={#4},#1}{#2}{#3}{#5}{#6}%
}

% \chromatogram[pgfplots options][placement]{csv}{peaks}{caption}  (v1.19.0)
%   A chromatogram from gc_tool.py's plain (or cropped) CSV. \labplot with
%   technique=gc by default; `technique=` names the plot kind, so another
%   chromatography (HPLC, ...) is \chromatogram[technique=hplc] once an
%   hplc kind has been defined with \labdefineplotkind -- none is yet,
%   deliberately: its defaults should come from a real instrument file,
%   not a guess. peaks = x/apex_y/label_y/name entries (see \Lab@apexpeak),
%   printed ready to paste by `gc_tool.py integrate`, together with the
%   ymax that leaves room for the labels -- pass it, as \irspectrum's ymin.
\NewDocumentCommand{\chromatogram}{O{} O{H} m m m}{%
  \Lab@labplot{technique=gc,#1}{#2}{#3}{#4}{#5}%
}

% \irspectrumcompare[pgfplots options][placement]{csv-top}{csv-bottom}{panel-opts-top}{panel-opts-bottom}{peaks-top}{peaks-bottom}{caption}
%   Two stacked panels, independent y-scales, shared x-axis (wavenumber) on
%   the bottom panel only. #1 applies to BOTH panels (shared x-range, house
%   colour, etc). #4/#5 are each a full pgfplots key list for THAT panel
%   alone — always include ylabel there, and ymin once that panel's peaks
%   are labelled (see the headroom note above; independent y-scales is the
%   whole point of this macro, so there is no shared default to fall back
%   on): {ylabel={Transmittance \%}, ymin=30}. Top panel is typically
%   "before" (reagent), bottom "after" (product), matching how the
%   Discussion narrates the reaction.
%
%   Second optional argument (added 2026-09-21, v1.16.0, LR4-5 prelab5):
%   same convention \irspectrum's own second optional argument already
%   uses (sec. above) -- a real LaTeX placement spec (default "t", so
%   every call before this version reproduces the old hardcoded [t]
%   exactly), or the literal value `none` for a NON-floating render:
%   `\begin{center}...\captionof{figure}{...}...\end{center}`, printed
%   exactly at the call site, never reordered relative to surrounding
%   text by the float algorithm. Added after real-document evidence, not
%   speculatively: prelab5.md placed this call deliberately (right after
%   a procedure's "Cleaning up" paragraph, immediately before a
%   `\pagebreak` into the next section) specifically to fill that
%   section's own trailing blank space on its page -- but plain [t]
%   pulled the float to the TOP of that page instead, ahead of the
%   `\procstep` text that precedes the call in the source, leaving the
%   figure floating disconnected from its own context with dead space
%   between its caption and the text below (confirmed by rendering both
%   ways and comparing, not guessed). `[none]` fixes this the same way it
%   already fixes the analogous case for \irspectrum: strict source-order
%   placement, and on overflow, ordinary TeX page-breaking (not the float
%   algorithm) starts a fresh page for it. Trade-off is the same one
%   \irspectrum's own comment already documents: a non-floating call can
%   never reorder to a page with more room, so IT is now the caller's job
%   to size/place it so it actually fits (see the "stretch height, don't
%   leave a gap" note below) -- and it loses whatever margin the [t]/[tbp]
%   investigation below fought hard to win back, so prefer plain
%   `\irspectrumcompare[...]{...}` (still the default) for the ordinary
%   case of "put this figure somewhere in the flow, let it move if it
%   doesn't fit"; reach for `[none]` only when the call is deliberately
%   placed to fill a SPECIFIC, already-measured gap, the way prelab5.md's
%   is. Sizing that gap is an ordinary pgfplots `height` override in #1
%   (applies to both panels, same as any other pgfplots key there) --
%   measure the actual available space (e.g. pixel-measure a render of
%   the page as-is, the way CLAUDE.md sec. 3 already asks for any geometry
%   claim) rather than guessing a height and hoping it's close; prelab5.md
%   uses `height=8.5cm` (the same value LR3 already uses for its own
%   `\irspectrumcompare` calls) against a measured 6.97in gap, landing at
%   a computed ~6.7in total block height with a small intentional margin
%   left over rather than cutting it exactly to the edge.
%
% PLACEMENT: [t], not [H] -- changed 2026-09-18 (v1.14.3/.5), LR3. Two panels
% at height=6.2cm each + 8pt sep + caption is close to a full text page, and
% [H] ("print exactly here, float.sty, never move") turned "doesn't fit the
% remaining page" into a large FIXED blank region earlier in the page flow
% (before the paragraphs/table preceding the call in the source), not a
% clean move to the next page. Confirmed by direct experiment, not guessed:
% forcing \raggedbottom left the blank region unchanged (ruling out
% \flushbottom's page-filling stretch, sec. above, as the cause), while
% removing the \irspectrumcompare call outright removed the blank region
% completely. [H]'s one documented reason (the "[H]-inside-landscape" rule
% on \irspectrum, sec. above) does not apply to \irspectrumcompare in any
% report that's used it so far -- none has ever put it inside `landscape`.
% \irspectrum itself is untouched: its own [H] has not shown this failure
% (it's ~9.5cm tall, comfortably under a full page) and appears
% deliberately inside `landscape` in some reports, where a real float
% cannot be trusted to move sensibly across the page-dimension swap -- do
% not "fix" both macros at once on the strength of only one being reported
% broken.
%
% [t], NOT [tbp]: v1.14.3 first shipped [tbp] (allowing a dedicated "float
% page" as a fallback). That fallback is a DIFFERENT LaTeX code path that
% unconditionally forces a page break right after the float (confirmed via
% \tracingpages: a p=-10000 penalty ships the page immediately once a float
% lands via the floats-only-page route), which is why every comparison
% figure landed alone on its own page even though each is only ~50% of
% \textheight and should comfortably share a page with ordinary text.
% Dropping `p` (and `b`, which never mattered here) forces the kernel to
% keep retrying [t] on later pages instead of ever taking that route.
% Confirmed by real measurement, not assumed: after this change two of the
% three comparison figures in LR3 (the ones following propiophenone/
% acetophenone and cinnamaldehyde) DO now share their page with the table/
% prose that follows, and the document is a full page shorter. Verified
% this is not a \flushbottom artifact either -- identical under
% \raggedbottom.
%
% ONE known, unresolved exception: LR3's FIRST comparison figure (2-
% butanone vs 2-pentanone, following Table 5) still lands alone even under
% [t], and neither \topfraction/\textfraction/\floatpagefraction tuning,
% \raggedbottom, a \FloatBarrier right after the preceding table, nor
% shrinking this figure to as little as 4.8cm/panel (a real readability
% cost, and still didn't work) changed that -- all tested directly, not
% guessed. \tracingpages shows \pagegoal already anomalously reduced
% (283.6pt instead of the normal ~688pt) at the exact point this specific
% float is retried, which the other two comparison figures do NOT show --
% something about what precedes THIS one (Table 5 itself spans a page
% break, unlike Table 7 before the cinnamaldehyde figure) leaves the page
% builder in a different state, but the exact mechanism was not isolated
% before this was shipped. If you pick this back up: a minimal standalone
% reproduction (a `labtabularbt` table forced to span a page break,
% followed by a few paragraphs, followed by an `\irspectrumcompare`-sized
% float) outside the full 28-page report would isolate this far faster
% than testing against the real document -- not done here for lack of
% time, flagged for whoever next has reason to chase it. See LR3's own
% `backups/review/findings.md` (2026-09-18) for the full experimental
% record (every test tried, exact measurements, exact commands).
% \irspectrumstack[pgfplots options][placement]{panels}{caption}   (v1.17.0)
%   N >= 2 stacked panels, the generalisation of \irspectrumcompare (which is
%   now a thin wrapper around it, below). panels = one \irpanel per panel,
%   top to bottom:
%     \irpanel{csv}{panel options}{peaks}
%   `panel options` and `peaks` mean exactly what \irspectrumcompare's
%   per-panel arguments mean (ylabel/ymin per panel; x/label_y peak list).
%   #1 applies to every panel, #2 is the same placement convention as
%   \irspectrumcompare's: a float spec, default [t], or [none] for a
%   non-floating render at the call site. Everything above about [t] versus
%   [H]/[tbp] applies unchanged -- the float machinery is the same code path.
%
%   Default panel height: a stack is tall, and a [t] float that cannot go
%   in the top area of a text page is never placed at all (no `p`, by
%   design, see above): it and every [t] float after it are held to the end
%   of the document. The top area is capped TWICE: by \topfraction, and by
%   \textfraction, the share of the page that must still be left for text
%   (default 0.2, so a float can never exceed 0.8 \textheight however high
%   \topfraction is raised). The second cap is what LR3's preamble.tex
%   records as an unexplained ceiling near 8.7cm/panel, and what sent all
%   four of LR4-5's figures from its first 3-panel stack onwards to the end
%   when this default used \topfraction alone (0.95 there): found
%   2026-09-23 by measuring the unplaced float at 20.1cm against a
%   0.8 x 22.43cm = 17.9cm cap. So unless #1 sets `height`, each panel gets
%       (min(\topfraction, 1 - \textfraction) x \textheight
%          - \Lab@irstack@overhead) / N.
%   Give `height` in #1 to override, as for \irspectrumcompare.
\newcount\Lab@irstack@n
% Measured 2026-09-23 (LR4-5 p. 25, 300 dpi, xelatex): a 3-panel stack at
% pgfplots height=6.44cm inked 20.14cm from the top y-tick label to the last
% caption line, with a four-line caption, i.e. 3h + 0.82cm (pgfplots'
% `height` already includes each panel's own tick/axis labels). Add
% \textfloatsep (~0.7cm here) below the float, and ~0.5cm for a longer
% caption: 2.0cm.
\newcommand{\Lab@irstack@overhead}{2.0cm}
\newdimen\Lab@irstack@budget
%
% Since v1.19.0 the stack body is kind-generic (\labstack; #1 kind, #2 the
% call's own keys, #3 the panels): \irspectrumstack is \labstack[kind=ir]
% and \chromatogramstack is \labstack[technique=gc]. A panel is
% \labpanel{csv}{panel options}{peaks}; \irpanel and \chrompanel are the
% same macro under the names each wrapper documents, so existing stacks
% keep working and a stack reads naturally for its own kind. One kind per
% stack: the panels share an x-axis, which only makes sense for one kind
% of data.
\newcommand{\Lab@stackbody}[3]{%
  % count the panels first, in a box so nothing is typeset
  \global\Lab@irstack@n\z@
  \setbox\z@\hbox{\def\labpanel##1##2##3{\global\advance\Lab@irstack@n\@ne}%
    \let\irpanel\labpanel\let\chrompanel\labpanel#3}%
  \ifnum\Lab@irstack@n<\@ne \global\Lab@irstack@n\@ne \fi
  \Lab@irstack@budget=\topfraction\textheight
  \dimen@=\dimexpr\textheight-\textfraction\textheight\relax
  \ifdim\dimen@<\Lab@irstack@budget \Lab@irstack@budget=\dimen@ \fi
  \edef\Lab@irstack@auto{%
    group style={group size=1 by \the\Lab@irstack@n,
      vertical sep=8pt, x descriptions at=edge bottom},
    height=\the\dimexpr(\Lab@irstack@budget
      -\Lab@irstack@overhead)/\Lab@irstack@n\relax}%
  \def\labpanel##1##2##3{\Lab@panelsplit{##2}{\Lab@stackpanel{#1}{##1}{##3}}}%
  \let\irpanel\labpanel\let\chrompanel\labpanel
  \begin{tikzpicture}
    \expandafter\Lab@stack@groupplot\expandafter{\Lab@irstack@auto}{#2}{#1}
    #3
    \end{groupplot}
  \end{tikzpicture}%
}
% One panel of a stack. #1 kind, #2 csv, #3 peaks, #4 the panel's keys with
% its own `trace color`/`label color` already taken out (v1.25.0: this used
% to be inline in \Lab@stackbody, with nuirred hardcoded).
%   The pick comes AFTER \nextgroupplot, which closes the previous panel's
%   TeX group (a pick before it was discarded with that group), and the
%   \addplot is \expanded because pgfplots only builds the PREVIOUS panel's
%   plot when the next \nextgroupplot arrives: a bare \Lab@tc there is read
%   with the next panel's colour (seen on the first overlay-era test: the
%   panels' colours were swapped).
\newcommand{\Lab@stackpanel}[4]{%
  \nextgroupplot[#4]
  \Lab@pickstd
  \expanded{\noexpand\addplot[color=\Lab@tc, line join=round]}
    table[nulab kind #1 table,col sep=comma] {#2};
  \csname Lab@kind@#1@peaks\endcsname{#3}}
\newcommand{\Lab@stack@groupplot}[3]{%
    \begin{groupplot}[
      width=14.5cm,
      #1,
      nulab kind #3,
      nulab kind #3 stack,
      every axis plot/.append style={line width=0.5pt},
      #2,
    ]}
% Overlay (v1.25.0): the panels of a stack drawn on ONE axis instead of one
% under another -- the reference report's reactant-over-product figure (red
% and black, labels in their line's colour), asked for as the third optional
% argument of \irspectrumstack/\irspectrumcompare/\labstack and as
% \irspectrumoverlay. Same panel syntax as a stack, so a figure can be
% switched between the two by changing one word.
%   * It is one axis, so it is built like \Lab@plotbody (a plain axis, 14.5 x
%     9.5 cm, the kind's own keys, no groupplot, no `nulab kind .. stack`
%     y-label shift), not like \Lab@stackbody.
%   * The call's keys (#2) and the FIRST panel's own keys are the axis's
%     (ylabel, ymin, ymax...). Later panels' keys cannot be: there is one
%     axis, and a ymin chosen for one spectrum's labels would silently
%     override another's. They are ignored with a warning, except
%     `trace color` and `label color`, which are per trace by nature.
%     Choose a ymin low enough for the lowest label of ANY trace.
%   * Trace i is drawn in entry i of `overlay colors` (default black,
%     nuirred) and its labels, ticks included, in the same colour, unless
%     the panel says `trace color=`/`label color=`. More traces than
%     colours: the palette repeats, with a warning.
%   Pass 1 (in a box, nothing typeset) counts the panels and collects the
%   first panel's keys, because \begin{axis} needs them before any panel is
%   drawn; pass 2 draws.
\newcount\Lab@ov@i
\newcommand{\Lab@ovscan}[1]{%
  \ifnum\Lab@ov@i=\@ne
    \gdef\Lab@ov@axis{#1}%
  \else
    \def\Lab@ov@tmp{#1}%
    \ifx\Lab@ov@tmp\@empty\else
      \PackageWarning{nulabreport}{Overlay panel \the\Lab@ov@i\space has
        axis options (#1) that are ignored: an overlay has one axis. Put
        them in the call's first optional argument or in the first panel}%
    \fi
  \fi}
\newcommand{\Lab@ovpanel}[4]{%
  \Lab@ovpick{\the\Lab@ov@i}%
  \expanded{\noexpand\addplot[color=\Lab@tc, line join=round]}
    table[nulab kind #1 table,col sep=comma] {#2};
  \csname Lab@kind@#1@peaks\endcsname{#3}}
\newcommand{\Lab@overlaybody}[3]{%
  \global\Lab@ov@i\z@ \gdef\Lab@ov@axis{}%
  \setbox\z@\hbox{%
    \def\labpanel##1##2##3{\global\advance\Lab@ov@i\@ne
      \Lab@panelsplit{##2}{\Lab@ovscan}}%
    \let\irpanel\labpanel\let\chrompanel\labpanel#3}%
  \Lab@ovcheckpalette{\the\Lab@ov@i}%
  \global\Lab@ov@i\z@
  \def\labpanel##1##2##3{\global\advance\Lab@ov@i\@ne
    \Lab@panelsplit{##2}{\Lab@ovpanel{#1}{##1}{##3}}}%
  \let\irpanel\labpanel\let\chrompanel\labpanel
  \begin{tikzpicture}
    % \expandafter: the first panel's keys must be in the list itself, not
    % behind a macro (pgfkeys reads a macro there as ONE key name)
    \expandafter\Lab@ov@axisopen\expandafter{\Lab@ov@axis}{#1}{#2}
    #3
    \end{axis}
  \end{tikzpicture}%
}
\newcommand{\Lab@ov@axisopen}[3]{%
    \begin{axis}[
      width=14.5cm, height=9.5cm,
      nulab kind #2,
      every axis plot/.append style={line width=0.5pt},
      #3,
      #1,
    ]}
\newcommand{\Lab@labstack}[5]{%
  \Lab@plotsplit{#1}{\Lab@labstack@i{#2}{#3}{#4}{#5}}}
\newcommand{\Lab@labstack@i}[6]{%
  \Lab@stack@noinsets
  \Lab@placeplot{#1}{\Lab@stackselect{#2}{#5}{#6}{#3}}{#4}}
\ExplSyntaxOn
\cs_new_protected:Npn \Lab@stack@noinsets
  {
    \tl_if_empty:NF \l__nulab_plot_insets_tl { \msg_warning:nnn { nulabreport } { inset-stack } { inset } }
    \tl_if_empty:NF \l__nulab_plot_integrals_tl { \msg_warning:nnn { nulabreport } { inset-stack } { integrals } }
  }
\ExplSyntaxOff
% mode: `stack` (the default, and what every call before v1.25.0 meant) or
% `overlay` (one shared axis, see \Lab@overlaybody).
\newcommand{\Lab@stackselect}[4]{%
  \ifstrequal{#1}{overlay}{\Lab@overlaybody{#2}{#3}{#4}}{%
    \ifstrequal{#1}{stack}{\Lab@stackbody{#2}{#3}{#4}}{%
      \PackageError{nulabreport}{Unknown stack mode `#1'}%
        {The third optional argument is `stack' (panels one under another, the
         default) or `overlay' (all traces on one axis).}}}}
% \labstack[kind=..., keys][placement][mode]{\labpanel...\labpanel...}{caption}
\NewDocumentCommand{\labstack}{O{} O{t} O{stack} m m}{%
  \Lab@labstack{#1}{#2}{#3}{#4}{#5}}
\NewDocumentCommand{\irspectrumstack}{O{} O{t} O{stack} m m}{%
  \Lab@labstack{kind=ir,#1}{#2}{#3}{#4}{#5}}
% \irspectrumoverlay[pgfplots options][placement]{panels}{caption}   (v1.25.0)
%   \irspectrumstack with the third optional argument already set to
%   `overlay`: the same \irpanel{csv}{panel options}{peaks} list, but all the
%   spectra on one axis, each in its own colour with its labels to match
%   (see \Lab@overlaybody). Placement default [H], like \irspectrum and unlike
%   the stack it wraps: an overlay is one 9.5 cm axis, the same kind of figure
%   as a single spectrum, and belongs where it is written, not pinned to the
%   top of a page. (\irspectrumstack[..][t][overlay] keeps the stack's [t].)
\NewDocumentCommand{\irspectrumoverlay}{O{} O{H} m m}{%
  \irspectrumstack[#1][#2][overlay]{#3}{#4}}
% \chromatogramstack[keys][placement]{\chrompanel{csv}{panel opts}{peaks}...}{caption}
%   Several chromatograms (e.g. groups 1-5 of one experiment) stacked with
%   a shared retention-time axis and independent y-scales -- the same
%   reasoning as \irspectrumstack: a weak run next to a strong one is only
%   readable on its own scale. Pass ymax per panel (gc_tool.py's value).
\NewDocumentCommand{\chromatogramstack}{O{} O{t} O{stack} m m}{%
  \Lab@labstack{technique=gc,#1}{#2}{#3}{#4}{#5}}

% \irspectrumcompare: since v1.17.0 a wrapper, two \irpanel's with the
% historical 6.2cm panel height (placed before #1, so a call's own
% height=... still wins exactly as before). The separate
% \Lab@irspectrumcompareplot body it used to have is gone; the pgfplots keys
% are the same, so LR3 and prelab5 render as before (checked by pixel diff).
% Nine arguments was already the ceiling (a macro body only has #1..#9), so
% the third optional (v1.25.0) cannot simply be added: the three optionals
% are taken first and written INTO a local \Lab@compare, which then takes
% the seven mandatory ones. (Parking them in macros instead does not work: a
% float placement in [..] is not expanded, \begin{figure}[\Lab@cmp@place]
% dies with "Unknown float option".) What the caller types is unchanged.
\NewDocumentCommand{\irspectrumcompare}{O{} O{t} O{stack}}{%
  \def\Lab@compare##1##2##3##4##5##6##7{%
    % the 6.2cm panel height is a stacked panel's; an overlay is ONE axis
    % and keeps \irspectrum's own 9.5cm
    \ifstrequal{#3}{overlay}{%
      \irspectrumstack[#1][#2][overlay]%
        {\irpanel{##1}{##3}{##5}\irpanel{##2}{##4}{##6}}{##7}}{%
      \irspectrumstack[height=6.2cm,#1][#2][#3]%
        {\irpanel{##1}{##3}{##5}\irpanel{##2}{##4}{##6}}{##7}}}%
  \Lab@compare}

% ---------------------------------------------------------------------------
% \irspectrumpage[pgfplots options][where]{panels}{caption}      (v1.20.0)
% \labstackpage[kind=..., options][where]{panels}{caption}
% \chromatogrampage[options][where]{panels}{caption}
%
%   A stack (same panels as \irspectrumstack: one \irpanel{csv}{panel
%   options}{peaks} each) given a whole page of its own, with its caption at
%   the foot of that page. Asked for in the LR4-5 review so that a band
%   table's spectra can sit between its discussion and the table itself:
%   "the paragraph that runs before it just fills the previous page, the
%   next page is those stacked spectra, and the next page is just the
%   previous paragraph ... that flows as if there even was no ir spectrum
%   page at all."
%
%   That is how it behaves: the call puts nothing into the text. The page
%   the call falls on is filled and broken exactly as it would be without
%   it, and the spectrum page is shipped out right AFTER that page (where =
%   next, the default) or right BEFORE it (where = previous; `before` is
%   accepted too). Everything carries on across it, a paragraph or a
%   table mid-way through included. It is an ordinary page of the document:
%   same header and footer, next page number.
%
%   Panel height is not a guess. The caption is typeset first and
%   measured, the stack is rendered once at a trial height and measured,
%   and the height is corrected (again if needed) until stack + caption fill
%   \textheight to within a point. So a long caption gives shorter panels,
%   and the caption is always on the page with the last panel.
%
%   Panel count: 3 is the design case; 2 and 4 are fine. One panel works
%   but warns (a portrait page for one spectrum: \irspectrum, or a
%   landscape page, is the better choice). More than 4 are split over
%   ceil(N/3) pages of 2 or 3 panels, in the order given (5 -> 3+2, 7 ->
%   3+2+2, 8 -> 3+3+2); each page fills itself, only the last carries the
%   caption, and the earlier ones say "Figure N, continued on the next
%   page." at their foot. One figure number for the whole series.
%
%   How it is done (and why not a float): the stack and its caption are
%   typeset into saved page boxes at the call site, where \label and
%   \refstepcounter work normally. The call then leaves a zero-size
%   insertion (class \Lab@pg@ins, \count 0, so it has no effect on page
%   breaking) as an anchor. When the output routine ships a page, the
%   anchors that landed on it are counted from the insertion box, and the
%   saved pages are shipped through \@outputpage itself, before or after
%   that page (the kernel's build/page/before and build/page/after hooks),
%   so they get the page counter and the eso-pic header/footer like any
%   other page. A [p] float would do the `next` case, but it queues behind
%   any figure still waiting to be placed and cannot do `previous` at all.
%   Special outputs (a float being placed mid-page) put the anchor back with
%   \@reinserts, exactly as the kernel does for footnotes, and the anchor
%   shares a footnote's one imprecision: if placing that float pushes the
%   anchor's line onto the next page, the anchor still counts for this one.
%
%   Limitations: call it between paragraphs in the main text (a raw
%   {=latex} block in markdown does exactly that), not inside a box, float
%   or minipage, where an insertion cannot reach the page. Two calls on the
%   same page ship in source order. The figure number is taken where the
%   call is, so a figure that floats past the call keeps its lower number.
% ---------------------------------------------------------------------------
\newinsert\Lab@pg@ins
\count\Lab@pg@ins=\z@ \dimen\Lab@pg@ins=\maxdimen \skip\Lab@pg@ins=\z@skip
\newcount\Lab@pg@npages    % saved page boxes made so far
\newcount\Lab@pg@nanchors  % anchors (calls) made so far
\newcount\Lab@pg@nshipped  % anchors whose pages have been shipped
\newcount\Lab@pg@here      % anchors on the page being output
\newcount\Lab@pg@np        % panels in the current call
\newcount\Lab@pg@nchunks   % pages the current call is split into
\newcount\Lab@pg@base      % panels per page, before the remainder
\newcount\Lab@pg@extra     % pages that take one more panel
\newcount\Lab@pg@chunk     % page being built (1..nchunks)
\newcount\Lab@pg@i         % panel index
\newcount\Lab@pg@size      % panels on the page being built
\newcount\Lab@pg@first     % first saved page of the current call
\newcount\Lab@pg@a         % anchor loop index (output routine)
\newcount\Lab@pg@p         % page loop index (output routine)
\newcount\Lab@pg@tries
\newbox\Lab@pg@hold
\newbox\Lab@pg@stackbox
\newbox\Lab@pg@capbox
\newdimen\Lab@pg@avail
\newdimen\Lab@pg@h
\newdimen\Lab@pg@diff
\newif\ifLab@pg@busy
% Left free at the foot of the page, so rounding can never push the caption
% into the footer.
\newcommand{\Lab@pg@safety}{2pt}

\ExplSyntaxOn
\msg_new:nnn { nulabreport } { stackpage-one }
  { \token_to_str:N \irspectrumpage \c_space_tl with ~ a ~ single ~ panel ~
    on ~ line ~ \msg_line_number: . ~ One ~ spectrum ~ stretched ~ over ~ a ~
    whole ~ portrait ~ page ~ reads ~ badly: ~ \token_to_str:N \irspectrum \c_space_tl
    (in ~ the ~ text), ~ or ~ a ~ landscape ~ page, ~ is ~ the ~ better ~ choice. }
\msg_new:nnn { nulabreport } { stackpage-none }
  { \token_to_str:N \irspectrumpage \c_space_tl without ~ any ~ \token_to_str:N \irpanel
    \c_space_tl on ~ line ~ \msg_line_number: ; ~ nothing ~ was ~ made. }
\msg_new:nnn { nulabreport } { stackpage-where }
  { Unknown ~ page ~ position ~ `#1' ~ for ~ \token_to_str:N \irspectrumpage :
    ~ use ~ next ~ (the ~ default) ~ or ~ previous. ~ Using ~ next. }
\msg_new:nnn { nulabreport } { stackpage-overfull }
  { A ~ stack ~ page ~ on ~ line ~ \msg_line_number: \c_space_tl is ~ #1 ~ taller ~
    than ~ the ~ page ~ after ~ correction; ~ shorten ~ its ~ caption. }
\cs_new_protected:Npn \Lab@pg@warnone { \msg_warning:nn { nulabreport } { stackpage-one } }
\cs_new_protected:Npn \Lab@pg@errnone { \msg_error:nn { nulabreport } { stackpage-none } }
\cs_new_protected:Npn \Lab@pg@warnwhere #1 { \msg_warning:nnn { nulabreport } { stackpage-where } {#1} }
\cs_new_protected:Npn \Lab@pg@warnfull #1 { \msg_warning:nnn { nulabreport } { stackpage-overfull } {#1} }
\ExplSyntaxOff

\def\Lab@pg@w@next{next}
\def\Lab@pg@w@previous{previous}
\def\Lab@pg@w@before{previous}

% The call. #1 where, #2 panels, #3 caption, #4 kind, #5 the other keys
% (from \Lab@plotsplit).
\newcommand{\Lab@labstackpage}[4]{%
  \Lab@plotsplit{#1}{\Lab@labstackpage@i{#2}{#3}{#4}}}
\newcommand{\Lab@labstackpage@i}[5]{%
  \@ifundefined{Lab@pg@w@#1}%
    {\Lab@pg@warnwhere{#1}\def\Lab@pg@where{next}}%
    {\edef\Lab@pg@where{\csname Lab@pg@w@#1\endcsname}}%
  % collect the panels, one macro each (in a box, so nothing is typeset)
  \global\Lab@pg@np\z@
  \setbox\z@\hbox{%
    \def\labpanel##1##2##3{\global\advance\Lab@pg@np\@ne
      \expandafter\gdef\csname Lab@pg@panel@\the\Lab@pg@np\endcsname
        {\labpanel{##1}{##2}{##3}}}%
    \let\irpanel\labpanel\let\chrompanel\labpanel#2}%
  \ifnum\Lab@pg@np<\@ne
    \Lab@pg@errnone
  \else
    \ifnum\Lab@pg@np=\@ne \Lab@pg@warnone \fi
    % pages: one for up to 4 panels, else ceil(N/3), filled as evenly as
    % possible (first pages take the remainder)
    \ifnum\Lab@pg@np>4
      \Lab@pg@nchunks=\Lab@pg@np \advance\Lab@pg@nchunks\tw@
      \divide\Lab@pg@nchunks\thr@@ % ceil(N/3); \divide truncates
    \else
      \Lab@pg@nchunks=\@ne
    \fi
    \Lab@pg@base=\Lab@pg@np \divide\Lab@pg@base\Lab@pg@nchunks
    \Lab@pg@extra=\numexpr\Lab@pg@np-\Lab@pg@base*\Lab@pg@nchunks\relax
    \Lab@pg@first=\numexpr\Lab@pg@npages+1\relax
    \Lab@pg@i=\@ne
    \Lab@pg@chunk=\z@
    \Lab@pg@buildall{#4}{#5}{#3}%
    % the anchor
    \global\advance\Lab@pg@nanchors\@ne
    \expandafter\xdef\csname Lab@pg@anchor@\the\Lab@pg@nanchors\endcsname
      {{\Lab@pg@where}{\the\Lab@pg@first}{\the\Lab@pg@npages}}%
    \insert\Lab@pg@ins{\hbox{}}%
  \fi}

% One saved page per chunk. #1 kind, #2 keys, #3 caption.
\newcommand{\Lab@pg@buildall}[3]{%
  \advance\Lab@pg@chunk\@ne
  \Lab@pg@size=\Lab@pg@base
  \ifnum\Lab@pg@chunk>\Lab@pg@extra\else \advance\Lab@pg@size\@ne \fi
  \def\Lab@pg@panels{}%
  \Lab@pg@collect
  \Lab@pg@build{#1}{#2}{#3}%
  \ifnum\Lab@pg@chunk<\Lab@pg@nchunks
    \expandafter\@firstofone
  \else
    \expandafter\@gobble
  \fi
  {\Lab@pg@buildall{#1}{#2}{#3}}}
% Appends \Lab@pg@size panels, from \Lab@pg@i on, to \Lab@pg@panels.
\newcommand{\Lab@pg@collect}{%
  \ifnum\Lab@pg@size>\z@
    \edef\Lab@pg@panels{\unexpanded\expandafter{\Lab@pg@panels}%
      \unexpanded\expandafter\expandafter\expandafter
        {\csname Lab@pg@panel@\the\Lab@pg@i\endcsname}}%
    \advance\Lab@pg@i\@ne
    \advance\Lab@pg@size\m@ne
    \expandafter\Lab@pg@collect
  \fi}

% The foot of a saved page: the real caption on the last page of a series,
% a "continued" line on the others. #1 = 1 for the last page, #2 caption.
\newcommand{\Lab@pg@foot}[2]{%
  \ifnum#1=\@ne
    \ifLab@barecaptions
      \gdef\Lab@barefootertext{#2}%
    \else
      \captionof{figure}{#2}%
    \fi
  \else
    \par\vskip\LabCaptionSkip
    {\centering\footnotesize\itshape
      Figure~\number\numexpr\value{figure}+1\relax, continued on the next
      page.\par}%
  \fi}
\newcommand{\Lab@pg@pageinit}{%
  \hsize\textwidth \linewidth\textwidth \columnwidth\textwidth
  \@parboxrestore \normalsize}

% Renders the current chunk at height \Lab@pg@h into \Lab@pg@stackbox.
% #1 kind, #2 keys.
\newcommand{\Lab@pg@render}[2]{%
  \edef\Lab@pg@keys{\unexpanded{#2},height=\the\Lab@pg@h}%
  \setbox\Lab@pg@stackbox\hbox{%
    \expandafter\Lab@pg@render@i\expandafter{\Lab@pg@keys}{#1}}}
\newcommand{\Lab@pg@render@i}[2]{\Lab@stackbody{#2}{#1}{\Lab@pg@panels}}

\newcommand{\Lab@pg@build}[3]{%
  \ifnum\Lab@pg@chunk=\Lab@pg@nchunks \def\Lab@pg@islast{1}%
  \else \def\Lab@pg@islast{0}\fi
  % 1. the caption, measured without stepping the counter or setting labels,
  %    under a 100pt stand-in for the plot (an \hbox of depth 0, as a
  %    tikzpicture is), so the interline glue TeX puts between the two on
  %    the real page is measured too -- measured alone, the "continued" note
  %    came out 2.9pt short and the page overfull
  \setbox\Lab@pg@capbox\vbox{%
    \Lab@pg@pageinit
    \let\label\@gobble
    \edef\Lab@pg@fig{\the\c@figure}%
    \hbox{\vrule\@width\z@\@height100\p@\@depth\z@}%
    \Lab@pg@foot{\Lab@pg@islast}{#3}%
    \global\c@figure\Lab@pg@fig\relax}%
  \Lab@pg@avail=\dimexpr\textheight-\ht\Lab@pg@capbox-\dp\Lab@pg@capbox
    +100\p@-\Lab@pg@safety\relax
  % 2. the stack: a trial at an even share of the room, then corrected by
  %    the measured shortfall (pgfplots' `height` counts its own tick and
  %    axis labels only approximately, so the first render is never exact)
  \Lab@pg@tries=\z@
  \Lab@pg@h=\dimexpr\Lab@pg@avail/\Lab@pg@sizeof\relax
  \Lab@pg@fit{#1}{#2}%
  % 3. the page itself
  \global\advance\Lab@pg@npages\@ne
  \expandafter\newbox\csname Lab@pg@box@\the\Lab@pg@npages\endcsname
  \global\setbox\csname Lab@pg@box@\the\Lab@pg@npages\endcsname
    \vbox to\textheight{%
      \Lab@pg@pageinit
      \hbox to\textwidth{\hss\box\Lab@pg@stackbox\hss}%
      \Lab@pg@foot{\Lab@pg@islast}{#3}%
      \vfil}}
% panels on this page (the loop in \Lab@pg@collect counted \Lab@pg@size
% down to 0, so it is recomputed here)
\newcommand{\Lab@pg@sizeof}{%
  \numexpr\Lab@pg@base
    +\ifnum\Lab@pg@chunk>\Lab@pg@extra 0\else 1\fi\relax}
\newif\ifLab@pg@again
\newcommand{\Lab@pg@fit}[2]{%
  \Lab@pg@render{#1}{#2}%
  \advance\Lab@pg@tries\@ne
  \Lab@pg@diff=\dimexpr\Lab@pg@avail-\ht\Lab@pg@stackbox-\dp\Lab@pg@stackbox\relax
  \Lab@pg@againfalse
  \ifdim\ifdim\Lab@pg@diff<\z@ -\fi\Lab@pg@diff>0.5pt
    \ifnum\Lab@pg@tries<4
      \advance\Lab@pg@h by \dimexpr\Lab@pg@diff/\Lab@pg@sizeof\relax
      \Lab@pg@againtrue
    \else
      \ifdim\Lab@pg@diff<-\Lab@pg@safety
        \Lab@pg@warnfull{\the\dimexpr-\Lab@pg@diff\relax}\fi
    \fi
  \fi
  \ifLab@pg@again
    \expandafter\@firstofone
  \else
    \expandafter\@gobble
  \fi
  {\Lab@pg@fit{#1}{#2}}}

% Output side. Count the anchors that came out on this page (one empty
% \hbox each), then ship `previous' pages before it and `next' pages after
% it. \Lab@pg@busy keeps the saved pages' own trip through \@outputpage
% from re-entering this.
\def\Lab@pg@count{%
  \global\Lab@pg@here\z@
  \setbox\z@\vbox{\unvbox\Lab@pg@ins\Lab@pg@countloop}%
  \global\setbox\Lab@pg@ins\box\voidb@x}
\def\Lab@pg@countloop{%
  \unskip\unpenalty\unkern
  \setbox\tw@\lastbox
  \ifvoid\tw@\else
    \global\advance\Lab@pg@here\@ne
    \expandafter\Lab@pg@countloop
  \fi}
% #1 = next or previous: ship every page of every anchor on this page that
% asked for that position.
\def\Lab@pg@shipall#1{%
  \def\Lab@pg@mode{#1}%
  \global\Lab@pg@a=\Lab@pg@nshipped
  \Lab@pg@shipall@i}
\def\Lab@pg@shipall@i{%
  \ifnum\Lab@pg@a<\numexpr\Lab@pg@nshipped+\Lab@pg@here\relax
    \global\advance\Lab@pg@a\@ne
    \expandafter\expandafter\expandafter\Lab@pg@shipanchor
      \csname Lab@pg@anchor@\the\Lab@pg@a\endcsname
    \expandafter\Lab@pg@shipall@i
  \fi}
\def\Lab@pg@shipanchor#1#2#3{%
  \def\Lab@pg@tmp{#1}%
  \ifx\Lab@pg@tmp\Lab@pg@mode
    \global\Lab@pg@p=#2\relax
    \def\Lab@pg@last{#3}%
    \Lab@pg@shippages
  \fi}
\def\Lab@pg@shippages{%
  \ifnum\Lab@pg@p>\Lab@pg@last\else
    \Lab@pg@shipone{\the\Lab@pg@p}%
    \global\advance\Lab@pg@p\@ne
    \expandafter\Lab@pg@shippages
  \fi}
\def\Lab@pg@shipone#1{%
  \global\setbox\Lab@pg@hold\box\@outputbox
  \global\setbox\@outputbox\box\csname Lab@pg@box@#1\endcsname
  \global\Lab@pg@busytrue
  \@outputpage
  \global\Lab@pg@busyfalse
  \global\setbox\@outputbox\box\Lab@pg@hold}
\AddToHook{build/page/before}[nulabreport/stackpage]{%
  \ifLab@pg@busy\else
    \ifvoid\Lab@pg@ins\else
      \Lab@pg@count
      \Lab@pg@shipall{previous}%
    \fi
  \fi}
\AddToHook{build/page/after}[nulabreport/stackpage]{%
  \ifLab@pg@busy\else
    \ifnum\Lab@pg@here>\z@
      \Lab@pg@shipall{next}%
      \global\advance\Lab@pg@nshipped\Lab@pg@here
      \global\Lab@pg@here\z@
    \fi
  \fi}
% A special output (a float being placed) gives the page back to the page
% builder; put the anchors back with it, as the kernel does for footnotes.
\g@addto@macro\@reinserts{%
  \ifvoid\Lab@pg@ins\else\insert\Lab@pg@ins{\unvbox\Lab@pg@ins}\fi}

\NewDocumentCommand{\labstackpage}{O{} O{next} m m}{%
  \Lab@labstackpage{#1}{#2}{#3}{#4}}
\NewDocumentCommand{\irspectrumpage}{O{} O{next} m m}{%
  \Lab@labstackpage{kind=ir,#1}{#2}{#3}{#4}}
\NewDocumentCommand{\chromatogrampage}{O{} O{next} m m}{%
  \Lab@labstackpage{technique=gc,#1}{#2}{#3}{#4}}
\makeatother
% --- plot-cache
% =============================================================================
% 15b. Plot cache (v1.26.0). INERT unless pdfmd defines \LabPlotCacheDir (this package's
% name for what pdfmd calls \pdfmdCacheDir; since pdfmd 3.28.37 the names this package uses
% are listed under `picture-cache:` in nulabreport-pdfmd.yaml, which pdfmd reads beside this
% file. It defines them only for
% `pdfmd-options: {cache: {plots: true}}` / `pdfmd --cache-plots`)
% under LuaLaTeX; with it undefined nothing below is defined, so a normal build
% is exactly what it was.
%
% When on, each whole plot picture -- \Lab@plotbody (single), \Lab@stackbody
% (stack and \irspectrumpage) and \Lab@overlaybody -- is looked up by a key:
% the md5 of the macro's name, its arguments and the layout it reads (text
% height/width, line width, font size, float fractions). A HIT includes the PDF
% pdfmd stored for that key, at the stored size, instead of typesetting; a MISS
% typesets exactly as before and appends the call to \jobname.plotreq, which
% pdfmd renders afterwards in a standalone job (\LabPlotRender defined: no
% lookup) for the next build. The stored file's box has the width, height and
% depth the picture had, so nothing around it moves. (Included at its natural
% size, not scaled: graphics' scale arithmetic is rounded, and a 0.05pt error
% there moved the lines of a 19 cm plot visibly against its own labels.)
%
% What keeps it from going stale is on pdfmd's side, not here: it keys the
% whole cache directory by a hash of this file, the document's preamble and
% the engine, and drops an entry whose data file (CSV) changed.
% =============================================================================
\makeatletter
% A scheme (\schemestart ... \schemestop) as one call: the unit of the scheme cache below, and what a request replays.
% chemfig keeps one thing a scheme can change and a later one reads: the greatest depth of the molecule names so far
% (\CF_dpmax, with gchemname on, which is its default). The standalone job hands it back to a build that finds the picture
% stored (\pdfmdCachePost), and the context starts it from the value the call had.
\newcommand{\Lab@sc@post}{\xdef\pdfmdCachePost{\unexpanded{\expandafter\xdef\csname CF_dpmax\endcsname}%
  {\csname CF_dpmax\endcsname}}}
\newcommand{\Lab@scheme}[2]{\schemestart #1\schemestop #2\Lab@sc@post}
\ifdefined\LabPlotCacheDir\ifdefined\directlua\ifdefined\LabPlotRender\else
  \newwrite\Lab@pc@req
  \AtBeginDocument{\immediate\openout\Lab@pc@req=\jobname.plotreq\relax}
  \newcommand{\Lab@pc@sep}{@@|@@}
  % md5 of the macro named #1, or `skip` if its text holds a character that
  % would not survive being written to a file and read back (%, #)
  % (no % or # may appear in this Lua: TeX reads it first, as a comment/parameter.
  % An escaped \% or \# in the call is fine; a bare one would not survive being
  % written to a file and read back, so such a call is not cached.)
  \newcommand{\Lab@pc@hash}[1]{%
    \directlua{local s = token.get_macro('#1')
      local t = s:gsub(string.char(92, 37, 37), ''):gsub(string.char(92, 35), '')
      if t:find(string.char(37), 1, true) or t:find(string.char(35), 1, true)
      then tex.sprint('skip') else tex.sprint(md5.sumhexa(s)) end}}
  % The plot macros also read five variables the CALL's own keys set before
  % they run (trace color, label color, overlay colors, insets, integrals:
  % \Lab@plotsplit). They are part of the key, and the standalone job sets
  % them from the request.
  \ExplSyntaxOn
  \cs_new:Npn \Lab@pc@state
    {
      \exp_not:N \tl_set:Nn \exp_not:N \l__nulab_plot_tcol_tl { \exp_not:V \l__nulab_plot_tcol_tl }
      \exp_not:N \tl_set:Nn \exp_not:N \l__nulab_plot_lcol_tl { \exp_not:V \l__nulab_plot_lcol_tl }
      \exp_not:N \clist_set:Nn \exp_not:N \l__nulab_plot_ovcols_clist { \exp_not:V \l__nulab_plot_ovcols_clist }
      % v1.28.2: the insets are drawn by \Lab@plotbody too
      \exp_not:N \tl_set:Nn \exp_not:N \l__nulab_plot_insets_tl { \exp_not:V \l__nulab_plot_insets_tl }
      % v1.28.4: and the integral curves
      \exp_not:N \tl_set:Nn \exp_not:N \l__nulab_plot_integrals_tl { \exp_not:V \l__nulab_plot_integrals_tl }
    }
  \ExplSyntaxOff
  \newcommand{\Lab@pc@extra}{}
  % #1 the public macro (recorded), #2 the original it replaced, #3 its
  % braced arguments
  \newcommand{\Lab@cached}[3]{%
    \edef\Lab@pc@ctx{\noexpand\textheight=\the\textheight\space
      \noexpand\textwidth=\the\textwidth\space
      \noexpand\linewidth=\the\linewidth\space
      \noexpand\columnwidth=\the\columnwidth\space
      \noexpand\def\noexpand\topfraction{\topfraction}%
      \noexpand\def\noexpand\textfraction{\textfraction}%
      \noexpand\fontsize{\f@size}{\f@baselineskip}\noexpand\selectfont
      \Lab@pc@state\unexpanded\expandafter{\Lab@pc@extra}}%
    \edef\Lab@pc@src{\string#1\detokenize{#3}\detokenize\expandafter{\Lab@pc@ctx}}%
    \edef\Lab@pc@key{\Lab@pc@hash{Lab@pc@src}}%
    \ifx\Lab@pc@key\Lab@pc@skip
      #2#3%
    \else
      \IfFileExists{\LabPlotCacheDir\Lab@pc@key.dim}{%
        \gdef\pdfmdCacheMargin{0pt}\global\let\pdfmdCachePostStored\relax
        \begingroup\endlinechar=-1 \catcode`\@=11
          \input{\LabPlotCacheDir\Lab@pc@key.dim}%
        \endgroup
        \setbox\z@\hbox{\kern-\pdfmdCacheMargin\raise-\dimexpr\Lab@pc@dp+\pdfmdCacheMargin\relax\hbox{%
          \includegraphics{\LabPlotCacheDir\Lab@pc@key.pdf}}}%
        \ht\z@=\Lab@pc@ht \dp\z@=\Lab@pc@dp \wd\z@=\Lab@pc@wd
        \pdfmdCachePostStored
        \leavevmode\box\z@
      }{%
        #2#3%
        \immediate\write\Lab@pc@req{\Lab@pc@key\Lab@pc@sep\string#1\Lab@pc@sep
          \detokenize{#3}\Lab@pc@sep\detokenize\expandafter{\Lab@pc@ctx}}%
      }%
    \fi}
  \newcommand{\Lab@pc@skip}{skip}
  \let\Lab@plotbody@raw\Lab@plotbody
  \renewcommand{\Lab@plotbody}[4]{\Lab@cached\Lab@plotbody\Lab@plotbody@raw{{#1}{#2}{#3}{#4}}}
  \let\Lab@stackbody@raw\Lab@stackbody
  \renewcommand{\Lab@stackbody}[3]{\Lab@cached\Lab@stackbody\Lab@stackbody@raw{{#1}{#2}{#3}}}
  \let\Lab@overlaybody@raw\Lab@overlaybody
  \renewcommand{\Lab@overlaybody}[3]{\Lab@cached\Lab@overlaybody\Lab@overlaybody@raw{{#1}{#2}{#3}}}
  % \irspectrumpage hands the panels over as a macro (\Lab@pg@panels): pass
  % their text, so the key and the request see it
  \renewcommand{\Lab@pg@render@i}[2]{%
    \expandafter\Lab@pc@pagestack\expandafter{\Lab@pg@panels}{#1}{#2}}
  \newcommand{\Lab@pc@pagestack}[3]{\Lab@stackbody{#3}{#2}{#1}}
  % ---- schemes (v1.28.5): a \schemestart ... \schemestop is one unbreakable drawing, looked up like a plot (pdfmd >= 3.28.35:
  % \pdfmdCacheVersion 3). Taken as a delimited argument at \schemestart, so what the cache sees is the text between the two
  % (its optional arguments included) and the \chemmove calls that follow it: they point at its named atoms (@{name}), so
  % scheme and arrows are one picture, and pdfmd typesets it twice (@@runs=2@@: TikZ's remember picture) -- rows and page
  % breaks around it stay live, and two schemes still fall on two pages. The context is the layout the plots use plus
  % chemfig's settings (the three key groups chemfig keeps: \setchemfig, \setcharge, the delimiters), read from
  % simplekv's own storage so a key a newer chemfig adds is in the key too, and the font; pdfmd reads them back with
  % ordinary catcodes (@@plain@@: a key's name has a space, which expl3 drops). NOT cached, typeset as ever: a scheme
  % with a ~ (chemfig reads it with a catcode a macro argument no longer has), a % or # in it, or in a colour (a
  % \color or \textcolor around it: the standalone job is black).
  \ifdefined\pdfmdCacheVersion\ifnum\pdfmdCacheVersion>2
  \let\Lab@schemestart@raw\schemestart
  \newcommand{\Lab@scheme@raw}[2]{\begingroup\let\schemestart\Lab@schemestart@raw\Lab@schemestart@raw #1\schemestop #2\endgroup}
  \newcommand{\Lab@sc@black}{0 g 0 G}
  \newcommand{\Lab@sc@look}[2]{%
    \edef\Lab@sc@text{\detokenize{#1#2}}%
    \edef\Lab@sc@color{\current@color}%
    \edef\Lab@sc@verdict{\directlua{
      local s = token.get_macro('Lab@sc@text')
      if s:find(string.char(126), 1, true)
         or s:find(string.char(37), 1, true) or s:find(string.char(35), 1, true)
      then tex.sprint('skip') else tex.sprint('ok') end}}%
    \ifx\Lab@sc@color\Lab@sc@black\else\def\Lab@sc@verdict{skip}\fi%
    \edef\Lab@sc@runs{\directlua{
      local s = token.get_macro('Lab@sc@text')
      if s:find(string.char(64, 123), 1, true) then tex.sprint('@@runs=2@@') end}}}
  \newcommand{\Lab@sc@dump}{%
    \directlua{
      local out = {}
      for _, group in ipairs({'chemfig', 'charge', 'CFdelimiters'}) do
        local list = token.get_macro('skv_list_of_default_keys_[' .. group .. ']') or ''
        local items = {}
        for key in list:gmatch('[^,]+') do
          local value = token.get_macro('skv_[' .. group .. ']_' .. key)
          if value then
            value = value:gsub('^\\skv_stop ?', '')
            table.insert(items, key .. '={' .. value .. '}')
          end
        end
        table.insert(out, '\\setKV[' .. group .. ']{' .. table.concat(items, ',') .. '}')
      end
      local text = table.concat(out)
      if text:find(string.char(37), 1, true) or text:find(string.char(35), 1, true)
      then tex.sprint('\\relax') else tex.sprint('\\unexpanded{' .. text .. '}') end}}
  \newcommand{\Lab@sc@cached}[2]{%
    \begingroup
      \Lab@sc@look{#1}{#2}%
      \ifx\Lab@sc@verdict\Lab@pc@skip
        \endgroup\Lab@scheme@raw{#1}{#2}%
      \else
        \edef\Lab@pc@extra{\unexpanded{@@plain@@@@margin=56pt@@}\Lab@sc@runs%
          \unexpanded{\expandafter\xdef\csname CF_dpmax\endcsname}{\csname CF_dpmax\endcsname}\Lab@sc@dump \unexpanded{\fontfamily}{\f@family}\unexpanded{\fontseries}{\f@series}%
          \unexpanded{\fontshape}{\f@shape}\unexpanded{\selectfont}}%
        \Lab@cached\Lab@scheme\Lab@scheme@raw{{#1}{#2}}%
        \endgroup
      \fi}
  % the \chemmove calls that follow the scheme belong to it (they point at its named atoms)
  \long\def\Lab@sc@grab#1\schemestop{\Lab@sc@tail{#1}{}}
  \long\def\Lab@sc@tail#1#2{%
    \@ifnextchar\chemmove{\Lab@sc@more{#1}{#2}}{\Lab@sc@cached{#1}{#2}}}
  \long\def\Lab@sc@more#1#2\chemmove{\@ifnextchar[{\Lab@sc@moveopt{#1}{#2}}{\Lab@sc@move{#1}{#2}[]}}
  \long\def\Lab@sc@moveopt#1#2[#3]{\Lab@sc@move{#1}{#2}[#3]}
  \long\def\Lab@sc@move#1#2[#3]#4{\Lab@sc@tail{#1}{#2\chemmove[#3]{#4}}}
  \let\schemestart\Lab@sc@grab
  \fi\fi
\fi\fi\fi
\makeatother
\makeatother
