\cs_new_protected:Npn \Lab@ovpick #1
  {
    \tl_set:Nx \l__nulab_pick_l_tl
      {
        \clist_item:Nn \l__nulab_plot_ovcols_clist
          { \int_eval:n { 1 + \int_mod:nn { #1 - 1 } { \clist_count:N \l__nulab_plot_ovcols_clist } } }
      }
